# Set to true on the live deployment while the site is being updated.
MAINTENANCE_MODE=false

# Long random secret used only for your private admin preview URL.
# Open https://your-domain.com/?preview=YOUR_SECRET once to receive the bypass cookie.
ADMIN_PREVIEW_TOKEN=replace-with-a-long-random-secret# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only secrets. Never expose these as NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
FAL_KEY=your_fal_key
# Use rzp_live_ keys for the production deployment.
RAZORPAY_MODE=live
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Optional production metadata
NEXT_PUBLIC_SITE_URL=https://your-domain.example
